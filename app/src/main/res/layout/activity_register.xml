<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".RegisterAppointmentActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitleRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_register"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitleRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="New appointment"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitleRegister" />

        <!-- ID Search field for CRUD Edit mode -->
        <EditText
            android:id="@+id/etId_Register"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:autofillHints="id"
            android:background="#F3F4F6"
            android:hint="@string/hint_search_id"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/btnSearch_Register"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitleRegister" />

        <Button
            android:id="@+id/btnSearch_Register"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary_purple"
            android:text="@string/btn_search"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/etId_Register"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/etId_Register"
            app:layout_constraintTop_toTopOf="@id/etId_Register" />

        <!-- Client Name -->
        <EditText
            android:id="@+id/etClientName_Register"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:autofillHints="name"
            android:background="#F3F4F6"
            android:hint="@string/hint_client_name"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/etId_Register" />

        <!-- Phone -->
        <EditText
            android:id="@+id/etPhone_Register"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:autofillHints="phone"
            android:background="#F3F4F6"
            android:hint="@string/hint_phone"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/etClientName_Register" />

        <!-- Service Spinner -->
        <Spinner
            android:id="@+id/spinnerService_Register"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="#F3F4F6"
            app:layout_constraintTop_toBottomOf="@id/etPhone_Register" />

        <!-- Date & Time -->
        <EditText
            android:id="@+id/etDate_Register"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:autofillHints="date"
            android:background="#F3F4F6"
            android:hint="@string/hint_date"
            android:inputType="date"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerService_Register" />

        <EditText
            android:id="@+id/etTime_Register"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:autofillHints="time"
            android:background="#F3F4F6"
            android:hint="@string/hint_time"
            android:inputType="time"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/etDate_Register" />

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnSave_Register"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/primary_purple"
            android:text="@string/btn_save_appointment"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/etTime_Register" />

        <Button
            android:id="@+id/btnRemove_Register"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/status_cancelled"
            android:text="@string/btn_delete_appointment"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnSave_Register" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
